# Copy to .env and edit if your setup differs from the defaults.
# Both variables are optional -- every sample falls back to these values.

# Which profile in ~/.databrickscfg to authenticate with.
DATABRICKS_PROFILE=genai-series

# Which serving endpoint to call.
# See what you have:  databricks serving-endpoints list --profile genai-series
SERVING_ENDPOINT=databricks-claude-haiku-4-5
