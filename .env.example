# Copy to .env, edit, then load it with: set -a; source .env; set +a
# Optional: override the default databricks-claude-haiku-4-5 endpoint.
SERVING_ENDPOINT=databricks-claude-haiku-4-5

# Which profile in ~/.databrickscfg to authenticate with. Needed on a laptop;
# omit it only where the environment already supplies Databricks credentials.
DATABRICKS_PROFILE=genai-series

# Who long-term memory belongs to (sample 4).
USER_ID=demo-user
