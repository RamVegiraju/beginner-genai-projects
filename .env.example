# Copy to .env, edit, then load it with: set -a; source .env; set +a
# Optional: override the default databricks-claude-haiku-4-5 endpoint.
SERVING_ENDPOINT=databricks-claude-haiku-4-5

# Optional: override the embedding endpoint used by sample 4.
EMBEDDING_ENDPOINT=databricks-gte-large-en

# Optional: load sample 4's guide from an existing Unity Catalog Volume.
# RAG_DOCUMENT=/Volumes/<catalog>/<schema>/<volume>/northstar-air-traveler-guide.md

# Optional: ask sample 4 a different question without editing rag.py.
# RAG_QUESTION=What is the change fee for a standard fare?

# Which profile in ~/.databrickscfg to authenticate with. Needed on a laptop;
# omit it only where the environment already supplies Databricks credentials.
DATABRICKS_PROFILE=genai-series

# Who long-term memory belongs to (sample 5).
USER_ID=demo-user
